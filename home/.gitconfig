[user]
	email = rossjrw@gmail.com
	name = Ross Williams
	signingkey = DBCA0670CCBC5A81
[core]
	autocrlf = input
	eol = lf
[credential "https://github.com"]
	username = rossjrw
	helper = "!~/.local/bin/git-credential-github"
[credential "https://gist.github.com"]
	username = rossjrw
	helper = "!~/.local/bin/git-credential-github"
[commit]
	gpgsign = true
[gpg]
	program = gpg
[alias]
	lg = log --all --color --graph --pretty=format:'  %C("#ffcc66")%h%Creset%Creset %C("#cc99cc")·%Creset %C("#99cc99")%cr%Creset by %C("#6699cc")%aN%Creset %C("#cc99cc")·%Creset %s%C("#f99157")%d' --abbrev-commit --invert-grep --grep='Deploying to gh-pages'
[rebase]
	autosquash = true
[init]
	defaultBranch = main
# Abbreviated branch names in the herdr sidebar, see ~/.config/herdr/plugins/branch-short.
# Needs git 2.54+ for config-based hooks; older git ignores this section.
# The trailing `:` swallows the hook arguments git appends after the `&`.
[hook "herdr-branch-short"]
	command = ~/.config/herdr/plugins/branch-short/branch-short.py >/dev/null 2>&1 & :
	event = post-checkout
	event = post-rewrite
